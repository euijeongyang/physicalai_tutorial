<mujoco model="torque_control">

    <compiler angle="radian"/>

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>

        <!-- Ground -->
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
            rgba="0.8 0.8 0.8 1"/>

        <!-- Robot Link -->
        <body name="link" pos="0 0 1">

            <joint
                name="joint1"
                type="hinge"
                axis="0 1 0"
                limited="true"
                range="-1.57 1.57"
                damping="0.5"/>

            <geom
                name="link_geom"
                type="capsule"
                fromto="0 0 0 0 0 0.8"
                size="0.05"
                mass="1"
                rgba="0.2 0.4 0.9 1"/>

            <!-- 관절 부분 시각화 -->
            <geom
                name="joint_geom"
                type="sphere"
                pos="0 0 0"
                size="0.09"
                mass="0"
                rgba="1 0.2 0.2 1"/>

        </body>

    </worldbody>

    <actuator>

        <!-- 이번 실습 Point -->
        <motor
            name="motor1"
            joint="joint1"
            gear="1"
            ctrllimited="true"
            ctrlrange="-100 100"/>

    </actuator>

</mujoco>