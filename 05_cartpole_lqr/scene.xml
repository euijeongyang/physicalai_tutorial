<mujoco model="cartpole_report">
    <compiler angle="radian" inertiafromgeom="false"/>
    <option timestep="0.002" gravity="0 0 -9.8"/>

    <worldbody>
        <light pos="0 0 3"/>
        <geom name="ground" type="plane" size="5 5 0.1"
              rgba="0.85 0.87 0.9 1"/>
        <geom name="rail" type="box" pos="0 0 0.22"
              size="2.7 0.05 0.04" contype="0" conaffinity="0"
              rgba="0.4 0.4 0.45 1"/>
        <geom name="origin_marker" type="box" pos="0 0 0.26"
              size="0.015 0.12 0.01" contype="0" conaffinity="0"
              rgba="0.2 0.7 0.2 1"/>
        <geom name="one_meter_marker" type="box" pos="1 0 0.26"
              size="0.015 0.12 0.01" contype="0" conaffinity="0"
              rgba="0.95 0.55 0.1 1"/>

        <body name="cart" pos="0 0 0.4">
            <joint name="cart_joint" type="slide" axis="1 0 0"
                   limited="true" range="-2.5 2.5" damping="0.1 0 0"/>
            <inertial pos="0 0 0" mass="0.2"
                      diaginertia="0.002 0.002 0.002"/>
            <geom name="cart_geom" type="box" size="0.2 0.14 0.1"
                  contype="0" conaffinity="0" rgba="0.2 0.4 0.9 1"/>

            <body name="pole" pos="0 0 0.1">
                <!-- +theta tilts the pole toward -X, matching the report's state convention. -->
                <joint name="pole_joint" type="hinge" axis="0 -1 0"/>
                <!-- Report parameters: m_p=0.5, l=0.3, I=0.3 (about pole COM). -->
                <inertial pos="0 0 0.3" mass="0.5"
                          diaginertia="0.3 0.3 0.01"/>
                <geom name="pole_geom" type="capsule"
                      fromto="0 0 0 0 0 0.6" size="0.025"
                      contype="0" conaffinity="0"
                      rgba="0.9 0.2 0.2 1"/>
                <geom name="pole_pivot" type="sphere" pos="0 0 0"
                      size="0.055" contype="0" conaffinity="0"
                      rgba="0.12 0.12 0.12 1"/>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="cart_motor" joint="cart_joint" gear="1"
               ctrllimited="true" ctrlrange="-30 30"/>
    </actuator>
</mujoco>
